# HALOCAS Environment Configuration Example

# Application Environment (development, testing, production)
ENVIRONMENT=development
PORT=8000
LOG_LEVEL=INFO

# Database Configuration (Neon Postgres in production, local Postgres in dev)
DATABASE_URL=postgresql+asyncpg://halocas_user:halocas_password@localhost:5432/halocas_db

# Redis Configuration (Optional for caching and pub/sub)
REDIS_URL=redis://localhost:6379/0

# Cloudflare R2 Object Storage
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY=your_r2_access_key
R2_SECRET_KEY=your_r2_secret_key
R2_BUCKET=halocas-clips

# Email Alerts (Resend API)
RESEND_API_KEY=re_your_resend_api_key
SMTP_SENDER=alerts@halocas.safety

# Security & Authentication
JWT_SECRET=supersecretjwtkeyforlocaldevelopmentonlyreplaceinprod
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=30

# Computer Vision & Safety Distance Parameters
YOLO_MODEL_PATH=yolov8n.pt
DEEPFACE_MODEL=Facenet512
SAFETY_CRITICAL_DISTANCE=3.0
SAFETY_WARNING_DISTANCE=10.0
PIXELS_PER_METER=20.0
ALERT_COOLDOWN_SECONDS=60
CLIP_DURATION_SECONDS=5
FPS=30
